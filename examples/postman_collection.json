            "description": "Optional: auto_renew, nameservers, addons, tld_extensions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"domains\": [\n    {\n      \"domain\": \"acme-corp.com\",\n      \"period\": 1,\n      \"allow_premium\": false,\n      \"auto_renew\": true,\n      \"addons\": {\n        \"id_protection\": true,\n        \"dns_management\": false,\n        \"email_forwarding\": false\n      },\n      \"contacts\": {\n        \"registrant\": {\n          \"contact_id\": \"{{contact_id}}\"\n        },\n        \"admin\": {\n          \"use_registrant\": true\n        },\n        \"tech\": {\n          \"use_registrant\": true\n        },\n        \"billing\": {\n          \"use_registrant\": true\n        }\n      },\n      \"nameservers\": [\n        \"ns1.example.com\",\n        \"ns2.example.com\"\n      ],\n      \"tld_extensions\": {}\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
